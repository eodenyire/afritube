# Copy to .env and fill in.

# Public URL of the AfriTube stream-ingest-auth edge function.
INGEST_AUTH_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/stream-ingest-auth

# Used by upload-replay.sh to push finished mp4 recordings to Storage
# and notify AfriTube that a replay is ready.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REPLAY_WEBHOOK_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/stream-replay-uploaded
REPLAY_BUCKET=videos
